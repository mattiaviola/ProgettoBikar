        <mxCell id="note" value="Package abbreviati rispetto a it.unipv.sfw.bikar. Le associazioni a Posizione e le dipendenze da enum sono riportate nei tipi dei membri; parametri mostrati in ordine, senza nome." style="html=1;whiteSpace=wrap;fontFamily=DejaVu Sans;fontColor=#202b35;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1630" width="2900" height="30" />
        </mxCell>
        <mxCell id="note2" value="Legenda: nome/metodo in corsivo = astratto; metodo sottolineato = statico; triangolo vuoto = ereditarietà; freccia tratteggiata = dipendenza; freccia continua = associazione navigabile." style="html=1;whiteSpace=wrap;fontFamily=DejaVu Sans;fontColor=#202b35;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=15;" vertex="1" parent="1">
